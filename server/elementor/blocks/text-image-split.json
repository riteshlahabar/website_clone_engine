{
  "elType": "container",
  "settings": {
    "content_width": "boxed",
    "flex_direction": "row",
    "flex_gap": { "unit": "px", "size": 44, "column": "44", "row": "44" },
    "flex_wrap": "wrap",
    "flex_align_items": "center",
    "padding": { "unit": "px", "top": "80", "right": "20", "bottom": "80", "left": "20", "isLinked": false },
    "background_background": "classic",
    "background_color": "{{bgColor}}"
  },
  "elements": [
    {
      "elType": "container",
      "isInner": true,
      "settings": {
        "content_width": "full",
        "flex_direction": "column",
        "width": { "unit": "%", "size": 46, "sizes": [] }
      },
      "elements": [
        {
          "elType": "widget",
          "widgetType": "image",
          "settings": {
            "image": { "url": "{{imageUrl}}", "id": "{{imageUrl_id}}", "alt": "{{imageAlt}}" },
            "image_size": "full",
            "align": "center",
            "border_radius": { "unit": "px", "top": "12", "right": "12", "bottom": "12", "left": "12", "isLinked": true }
          },
          "elements": []
        }
      ]
    },
    {
      "elType": "container",
      "isInner": true,
      "settings": {
        "content_width": "full",
        "flex_direction": "column",
        "width": { "unit": "%", "size": 46, "sizes": [] }
      },
      "elements": [
        {
          "elType": "widget",
          "widgetType": "heading",
          "settings": {
            "title": "{{heading}}",
            "header_size": "h2",
            "title_color": "{{headingColor}}",
            "typography_typography": "custom",
            "typography_font_size": { "unit": "px", "size": 32, "sizes": [] },
            "typography_font_weight": "700"
          },
          "elements": []
        },
        {
          "elType": "widget",
          "widgetType": "text-editor",
          "settings": {
            "editor": "<p>{{body}}</p>",
            "text_color": "{{textColor}}",
            "_margin": { "unit": "px", "top": "12", "right": "0", "bottom": "20", "left": "0", "isLinked": false }
          },
          "elements": []
        },
        {
          "elType": "widget",
          "widgetType": "button",
          "settings": {
            "text": "{{buttonText}}",
            "link": { "url": "{{buttonUrl}}", "is_external": "", "nofollow": "" },
            "align": "left",
            "size": "md",
            "background_color": "{{accentColor}}",
            "button_text_color": "#FFFFFF",
            "border_radius": { "unit": "px", "top": "6", "right": "6", "bottom": "6", "left": "6", "isLinked": true }
          },
          "elements": []
        }
      ]
    }
  ]
}
