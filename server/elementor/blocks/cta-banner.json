{
  "elType": "container",
  "settings": {
    "content_width": "boxed",
    "flex_direction": "column",
    "flex_align_items": "center",
    "padding": { "unit": "px", "top": "72", "right": "20", "bottom": "72", "left": "20", "isLinked": false },
    "background_background": "classic",
    "background_color": "{{bgColor}}"
  },
  "elements": [
    {
      "elType": "widget",
      "widgetType": "heading",
      "settings": {
        "title": "{{heading}}",
        "header_size": "h2",
        "align": "center",
        "title_color": "#FFFFFF",
        "typography_typography": "custom",
        "typography_font_size": { "unit": "px", "size": 34, "sizes": [] },
        "typography_font_weight": "700"
      },
      "elements": []
    },
    {
      "elType": "widget",
      "widgetType": "text-editor",
      "settings": {
        "editor": "<p style=\"text-align: center;\">{{subheading}}</p>",
        "text_color": "#E2E8F0",
        "_margin": { "unit": "px", "top": "12", "right": "0", "bottom": "24", "left": "0", "isLinked": false }
      },
      "elements": []
    },
    {
      "elType": "widget",
      "widgetType": "button",
      "settings": {
        "text": "{{buttonText}}",
        "link": { "url": "{{buttonUrl}}", "is_external": "", "nofollow": "" },
        "align": "center",
        "size": "md",
        "background_color": "{{accentColor}}",
        "button_text_color": "#FFFFFF",
        "border_radius": { "unit": "px", "top": "6", "right": "6", "bottom": "6", "left": "6", "isLinked": true }
      },
      "elements": []
    }
  ]
}
