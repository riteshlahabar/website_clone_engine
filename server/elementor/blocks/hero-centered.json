{
  "elType": "container",
  "settings": {
    "content_width": "boxed",
    "flex_direction": "column",
    "flex_align_items": "center",
    "flex_justify_content": "center",
    "min_height": { "unit": "vh", "size": 68, "sizes": [] },
    "padding": { "unit": "px", "top": "90", "right": "20", "bottom": "90", "left": "20", "isLinked": false },
    "background_background": "classic",
    "background_color": "{{bgColor}}"
  },
  "elements": [
    {
      "elType": "widget",
      "widgetType": "heading",
      "settings": {
        "title": "{{heading}}",
        "header_size": "h1",
        "align": "center",
        "title_color": "{{headingColor}}",
        "typography_typography": "custom",
        "typography_font_size": { "unit": "px", "size": 52, "sizes": [] },
        "typography_font_weight": "700",
        "typography_line_height": { "unit": "em", "size": 1.15, "sizes": [] }
      },
      "elements": []
    },
    {
      "elType": "widget",
      "widgetType": "text-editor",
      "settings": {
        "editor": "<p style=\"text-align: center;\">{{subheading}}</p>",
        "text_color": "{{textColor}}",
        "typography_typography": "custom",
        "typography_font_size": { "unit": "px", "size": 18, "sizes": [] },
        "_margin": { "unit": "px", "top": "14", "right": "0", "bottom": "26", "left": "0", "isLinked": false }
      },
      "elements": []
    },
    {
      "elType": "widget",
      "widgetType": "button",
      "settings": {
        "text": "{{buttonText}}",
        "link": { "url": "{{buttonUrl}}", "is_external": "", "nofollow": "" },
        "align": "center",
        "size": "md",
        "background_color": "{{accentColor}}",
        "button_text_color": "#FFFFFF",
        "border_radius": { "unit": "px", "top": "6", "right": "6", "bottom": "6", "left": "6", "isLinked": true }
      },
      "elements": []
    }
  ]
}
