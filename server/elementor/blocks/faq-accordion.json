{
  "elType": "container",
  "settings": {
    "content_width": "boxed",
    "flex_direction": "column",
    "padding": { "unit": "px", "top": "80", "right": "20", "bottom": "80", "left": "20", "isLinked": false },
    "background_background": "classic",
    "background_color": "{{bgColor}}"
  },
  "elements": [
    {
      "elType": "widget",
      "widgetType": "heading",
      "settings": {
        "title": "{{heading}}",
        "header_size": "h2",
        "align": "center",
        "title_color": "{{headingColor}}",
        "typography_typography": "custom",
        "typography_font_size": { "unit": "px", "size": 34, "sizes": [] },
        "typography_font_weight": "700",
        "_margin": { "unit": "px", "top": "0", "right": "0", "bottom": "32", "left": "0", "isLinked": false }
      },
      "elements": []
    },
    {
      "elType": "widget",
      "widgetType": "accordion",
      "settings": {
        "tabs": [
          { "tab_title": "{{q1}}", "tab_content": "<p>{{a1}}</p>", "_id": "faq0001" },
          { "tab_title": "{{q2}}", "tab_content": "<p>{{a2}}</p>", "_id": "faq0002" },
          { "tab_title": "{{q3}}", "tab_content": "<p>{{a3}}</p>", "_id": "faq0003" },
          { "tab_title": "{{q4}}", "tab_content": "<p>{{a4}}</p>", "_id": "faq0004" }
        ],
        "title_color": "{{headingColor}}",
        "tab_active_color": "{{accentColor}}",
        "content_color": "{{textColor}}",
        "icon_color": "{{accentColor}}"
      },
      "elements": []
    }
  ]
}
