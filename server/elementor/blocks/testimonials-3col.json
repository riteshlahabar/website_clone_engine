{
  "elType": "container",
  "settings": {
    "content_width": "boxed",
    "flex_direction": "column",
    "flex_align_items": "center",
    "padding": { "unit": "px", "top": "80", "right": "20", "bottom": "80", "left": "20", "isLinked": false },
    "background_background": "classic",
    "background_color": "{{bgColor}}"
  },
  "elements": [
    {
      "elType": "widget",
      "widgetType": "heading",
      "settings": {
        "title": "{{heading}}",
        "header_size": "h2",
        "align": "center",
        "title_color": "{{headingColor}}",
        "typography_typography": "custom",
        "typography_font_size": { "unit": "px", "size": 34, "sizes": [] },
        "typography_font_weight": "700",
        "_margin": { "unit": "px", "top": "0", "right": "0", "bottom": "40", "left": "0", "isLinked": false }
      },
      "elements": []
    },
    {
      "elType": "container",
      "isInner": true,
      "settings": {
        "content_width": "full",
        "flex_direction": "row",
        "flex_gap": { "unit": "px", "size": 28, "column": "28", "row": "28" },
