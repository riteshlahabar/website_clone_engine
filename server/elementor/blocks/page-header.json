{
  "elType": "container",
  "settings": {
    "content_width": "boxed",
    "flex_direction": "column",
    "flex_align_items": "center",
    "padding": { "unit": "px", "top": "64", "right": "20", "bottom": "64", "left": "20", "isLinked": false },
    "background_background": "classic",
    "background_color": "{{bgColor}}"
  },
  "elements": [
    {
      "elType": "widget",
      "widgetType": "heading",
      "settings": {
        "title": "{{heading}}",
        "header_size": "h1",
        "align": "center",
        "title_color": "{{headingColor}}",
        "typography_typography": "custom",
        "typography_font_size": { "unit": "px", "size": 40, "sizes": [] },
        "typography_font_weight": "700"
      },
      "elements": []
    },
    {
      "elType": "widget",
      "widgetType": "text-editor",
      "settings": {
        "editor": "<p style=\"text-align: center;\">{{subheading}}</p>",
        "text_color": "{{textColor}}",
        "_margin": { "unit": "px", "top": "10", "right": "0", "bottom": "0", "left": "0", "isLinked": false }
      },
      "elements": []
    }
  ]
}
