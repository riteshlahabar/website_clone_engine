{
  "name": "wp-site-builder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browser-driven WordPress + Elementor site builder (XAMPP, WP-CLI, no terminal)",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node server/index.ts",
    "ui:build": "vite build",
